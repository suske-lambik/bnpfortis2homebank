#!/usr/bin/env bash
#
# bnpfortis2homebank - convert a BNP Paribas Fortis CSV export to HomeBank CSV format
#
set -euo pipefail

PROG=$(basename "$0")
VERSION="1.0.0"

usage() {
    cat <<EOF
Usage: $PROG [OPTIONS] INPUT.csv

Convert a BNP Paribas Fortis CSV export (';'-separated, BOM and spaces in
header names are handled)
into HomeBank's CSV import format:
  date;payment;number;payee;memo;amount;category;tags

Options:
  -o, --output FILE      Write to FILE instead of standard output
  -f, --force            Overwrite FILE if it already exists
  -v, --value-date       Use Valutadatum instead of Uitvoeringsdatum as date
  -r, --include-refused  Also include refused transactions
  -n, --no-header        Do not write the header line
  -h, --help             Show this help and exit
  -V, --version          Show version and exit

Dates are written as yyyy-mm-dd: choose "y-m-d" in HomeBank's import dialog.
Transactions with an unknown 'Type_verrichting' get payment 0 and are
reported on standard error.

Examples:
  $PROG CSV_2026-10-18-07.52.csv > import.csv
  $PROG -o import.csv CSV_2026-10-18-07.52.csv
EOF
}

die() { echo "$PROG: $*" >&2; exit 1; }

output=""
force=0
date_col="Uitvoeringsdatum"
refused_filter="where coalesce(Reden_van_weigering,'') = ''"
header_opt="-O"
input=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)            usage; exit 0 ;;
        -V|--version)         echo "$PROG $VERSION"; exit 0 ;;
        -o|--output)          [[ $# -ge 2 ]] || die "option '$1' requires an argument"
                              output="$2"; shift 2 ;;
        --output=*)           output="${1#*=}"; shift ;;
        -f|--force)           force=1; shift ;;
        -v|--value-date)      date_col="Valutadatum"; shift ;;
        -r|--include-refused) refused_filter=""; shift ;;
        -n|--no-header)       header_opt=""; shift ;;
        --)                   shift; break ;;
        -*)                   die "unknown option '$1' (see --help)" ;;
        *)                    [[ -z "$input" ]] || die "only one input file allowed"
                              input="$1"; shift ;;
    esac
done
if [[ $# -gt 0 ]]; then
    [[ -z "$input" && $# -eq 1 ]] || die "only one input file allowed"
    input="$1"
fi

[[ -n "$input" ]]  || { usage >&2; exit 2; }
[[ -f "$input" ]]  || die "file not found: $input"
[[ -r "$input" ]]  || die "file not readable: $input"
command -v q >/dev/null 2>&1 || die "'q' is not installed (https://harelba.github.io/q/)"

# q needs a UTF-8 locale for non-ASCII text such as 'Domiciliëring'
if [[ "$(locale charmap 2>/dev/null)" != "UTF-8" ]]; then
    export LC_ALL=C.UTF-8
fi
if [[ -n "$output" && -e "$output" && $force -eq 0 ]]; then
    die "output file exists: $output (use --force to overwrite)"
fi

payment_case="
  case Type_verrichting
    when 'Kredietkaartbetaling'              then 1
    when 'Overschrijving in euro'            then 4
    when 'Instantoverschrijving in euro'     then 4
    when 'Kaartbetaling'                     then 6
    when 'Doorlopende betalingsopdracht'     then 7
    when 'Kosten in verband met de rekening' then 10
    when 'Domiciliëring'                     then 11
    when 'Hypotheekleningen Terugbetalingen' then 11
    else 0
  end"

query="
select
  substr($date_col,7,4)||'-'||substr($date_col,4,2)||'-'||substr($date_col,1,2) as date,
  $payment_case as payment,
  Volgnummer as number,
  replace(coalesce(Naam_van_de_tegenpartij,''),';',',') as payee,
  replace(coalesce(nullif(Mededeling,''),Details,''),';',',') as memo,
  printf('%.2f',Bedrag) as amount,
  '' as category,
  '' as tags
from -
$refused_filter
"

# Strip the UTF-8 BOM and turn spaces in the header into underscores,
# so both the raw bank export and an edited copy work
normalize() { sed '1{s/^\xEF\xBB\xBF//;s/ /_/g}' "$input"; }

# Warn about transaction types not covered by the mapping
unknown=$(normalize | q -H -d ';' \
    "select distinct Type_verrichting from - where ($payment_case) = 0")
if [[ -n "$unknown" ]]; then
    echo "$PROG: warning: unmapped transaction types (payment set to 0):" >&2
    sed 's/^/  /' <<<"$unknown" >&2
fi

if [[ -n "$output" ]]; then
    normalize | q -H -d ';' $header_opt -D ';' "$query" > "$output"
    lines=$(wc -l < "$output")
    [[ -n "$header_opt" ]] && lines=$((lines - 1))
    echo "$PROG: wrote $lines transactions to $output" >&2
else
    normalize | q -H -d ';' $header_opt -D ';' "$query"
fi
